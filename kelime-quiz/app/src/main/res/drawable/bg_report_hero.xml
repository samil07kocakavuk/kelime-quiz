<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#F0F6F8"
                android:endColor="#EAF3ED"
                android:startColor="#FFFFFF"
                android:type="linear" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#D7E5E0" />
        </shape>
    </item>
    <item android:top="14dp" android:right="14dp">
        <shape android:shape="oval">
            <solid android:color="#1A1B434D" />
            <size
                android:width="64dp"
                android:height="64dp" />
        </shape>
    </item>
    <item android:bottom="18dp" android:left="18dp">
        <shape android:shape="oval">
            <solid android:color="#14387E4F" />
            <size
                android:width="84dp"
                android:height="84dp" />
        </shape>
    </item>
</layer-list>
