<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#0C161A"
                android:endColor="#0A1215"
                android:startColor="#070C0F"
                android:type="linear" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#1E2A32" />
        </shape>
    </item>
    <item android:top="14dp" android:right="14dp">
        <shape android:shape="oval">
            <solid android:color="#1A26A69A" />
            <size
                android:width="64dp"
                android:height="64dp" />
        </shape>
    </item>
    <item android:bottom="18dp" android:left="18dp">
        <shape android:shape="oval">
            <solid android:color="#1426A69A" />
            <size
                android:width="84dp"
                android:height="84dp" />
        </shape>
    </item>
</layer-list>
